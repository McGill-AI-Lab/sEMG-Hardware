		(exclude_from_sim no)
		(at 20.32 262.254 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "88fe7530-cfc0-43e8-89b9-9a726f725ed5"))
	(text "Added: J2 programming header; the body-reference buffer (U8). Each channel's BPFOUT goes to an ESP32-S3 ADC1 pin (ATTEN3, 0 to 2.9 V): CH1 IO1, CH2 IO2, CH3 IO4, CH4 IO5, CH5 IO6, CH6 IO7, CH7 IO8, CH8 IO9 (IO3, a strapping pin, is skipped)."
		(exclude_from_sim no)
		(at 20.32 266.064 0)
		(effects (font (size 1.5 1.5)) (justify left bottom))
		(uuid "0a53cba8-f3be-4d49-81b6-529efcabc90a"))
